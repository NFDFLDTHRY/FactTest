+------------------------------------------------------------------------+
| SYSTEM
| @{system refine_ok}
| TYPES
| @{type T}
| EFFECTS / CAPABILITIES / IMPLEMENTATIONS
| @{effect NET}
| @{capability GPU_COMPUTE}
| COMPONENTS
| @{subsystem abstract_x}
| @{port abstract_x.i in: T public}
| @{port abstract_x.o out: T public}
| @{subsystem concrete_x}
| @{port concrete_x.i in: T public}
| @{port concrete_x.o out: T public}
| @{component inner}
| RELATIONS
| @{contains concrete_x -> inner}
| @{uses abstract_x NET}
| @{uses inner NET}
| @{requires abstract_x GPU_COMPUTE}
| @{requires concrete_x GPU_COMPUTE}
| @{refines concrete_x -> abstract_x}
| INVARIANTS
| @{invariant inv_ref refines(concrete_x, abstract_x)}
+------------------------------------------------------------------------+
