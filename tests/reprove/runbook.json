{
 "schema": "facttest-reprove-runbook/1",
 "note": "reviewed map from a selected fact to the group that re-proves it and the records whose expected observation decides PASS; a selected fact without an entry is a [GAP] (it stays stale)",
 "groups": {
  "identity": {
   "kind": "cite",
   "env_kind": "browser",
   "note": "produced by the identity capture (tests/reprove/identity.mjs -> tests/envmap/browser-probe.mjs)",
   "commands": []
  },
  "qualified-proof": {
   "kind": "build",
   "env_kind": "host",
   "commands": [
    "CARGO_TARGET_DIR=/home/user/factory-builds/d19-target cargo +1.94.1 build -p factory",
    "CARGO_TARGET_DIR=/home/user/factory-builds/d19-target sh tests/toolchain/run-qualified-proof.sh @OUT@/proof"
   ]
  },
  "kernel-sections": {
   "kind": "build",
   "env_kind": "host",
   "commands": [
    "sh tests/implementation/build-kernels.sh @OUT@/kernel /home/user/factory-builds/d19-kernels"
   ]
  },
  "paths": {
   "kind": "repo",
   "env_kind": "host",
   "commands": [
    "node tests/envmap/envmap.mjs paths-probe . --out @OUT@/paths/paths-probe.json"
   ]
  },
  "lineage": {
   "kind": "repo",
   "env_kind": "host",
   "commands": [
    "node tests/reprove/lineage.mjs --from 4a151c9ae58f9968c70b9b85cef82a02fba12b85 --out @OUT@/lineage/lineage.json"
   ]
  },
  "clauses": {
   "kind": "source",
   "env_kind": "sources",
   "commands": [
    "node tests/reference/clauses.mjs tests/reference/d15-clauses.json design/environment-map/graph.json @OUT@/clauses/D15",
    "node tests/reference/clauses.mjs tests/reference/d16-clauses.json design/environment-map/graph.json @OUT@/clauses/D16"
   ]
  },
  "reopen": {
   "kind": "source",
   "env_kind": "sources",
   "commands": [
    "T=$(mktemp -d) && node tests/envmap/envmap.mjs merge --base-rev fdb9c32 --epochs design/environment-map/epochs/D12.json,design/environment-map/epochs/D13.json --out $T/g13.json >/dev/null && node tests/reference/reopen.mjs $T/g13.json @OUT@/reopen"
   ]
  },
  "status": {
   "kind": "repo",
   "env_kind": "host",
   "commands": [
    "node tests/hygiene/status-scan.mjs --rules tests/hygiene/status-classification.json --out @OUT@/status-reprove",
    "sh tests/hygiene/handoff-check.sh @OUT@/status-reprove/handoff-check.json"
   ]
  }
 },
